{
  "name": "grd-dashboard-be",
  "version": "1.0.0",
  "description": "GRD Dashboard backend API",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=24.21.0 <25"
  },
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:dev:pretty": "nest start --watch | pino-pretty --colorize --levelFirst --messageKey message --timestampKey timestamp",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main.js",
    "start:worker": "nest start --entryFile worker",
    "start:worker:dev": "nest start --entryFile worker --watch",
    "start:worker:dev:pretty": "nest start --entryFile worker --watch | pino-pretty --colorize --levelFirst --messageKey message --timestampKey timestamp",
    "start:worker:prod": "node dist/worker.js",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "oxlint --deny-warnings .",
    "lint:fix": "oxlint --deny-warnings --fix .",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "test:cov": "vitest run --project unit --coverage",
    "test:cov:all": "pnpm build && vitest run --coverage",
    "test:container": "node --test test/container/runtime.test.ts",
    "test:shipping-quotes": "vitest run --project integration test/integration/shipping-quotes-contracts.spec.ts",
    "test:shipping-quotes:adapter:live": "pnpm build && node --env-file=.env test/support/shipping-quotes/live-adapter-smoke.mts",
    "test:shipping-quotes:live": "pnpm exec tsc --ignoreConfig --outDir .test-dist/sq-v1-001 --rootDir . --module nodenext --moduleResolution nodenext --target ES2023 --types node --strict --esModuleInterop --skipLibCheck test/support/shipping-quotes/provider-contracts.ts test/support/shipping-quotes/playwright-harness.ts test/support/shipping-quotes/live-contract-smoke.mts && node --env-file=.env .test-dist/sq-v1-001/test/support/shipping-quotes/live-contract-smoke.mjs",
    "test:integration": "pnpm build && vitest run --project integration",
    "typeorm": "typeorm",
    "entity:create": "typeorm entity:create",
    "subscriber:create": "typeorm subscriber:create",
    "migration:create": "typeorm migration:create",
    "migration:generate": "pnpm build && typeorm migration:generate -d dist/infrastructure/database/data-source.js",
    "migration:run": "pnpm build && typeorm migration:run -d dist/infrastructure/database/data-source.js",
    "migration:revert": "pnpm build && typeorm migration:revert -d dist/infrastructure/database/data-source.js",
    "migration:show": "pnpm build && typeorm migration:show -d dist/infrastructure/database/data-source.js",
    "schema:log": "pnpm build && typeorm schema:log -d dist/infrastructure/database/data-source.js",
    "test:e2e": "pnpm build && vitest run --project e2e",
    "prepare": "husky",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "auth:bootstrap": "pnpm build && node dist/auth-cli.js bootstrap",
    "auth:recover": "pnpm build && node dist/auth-cli.js recover"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@nestjs/cache-manager": "12.0.1",
    "@nestjs/common": "12.1.2",
    "@nestjs/config": "12.0.1",
    "@nestjs/core": "12.1.2",
    "@nestjs/platform-express": "12.1.2",
    "@nestjs/schedule": "12.0.2",
    "@nestjs/terminus": "12.1.0",
    "@nestjs/throttler": "6.7.1",
    "@nestjs/typeorm": "12.0.2",
    "axios": "1.20.0",
    "axios-cookiejar-support": "7.0.0",
    "axios-retry": "4.5.0",
    "better-auth": "1.7.7",
    "bottleneck": "2.19.5",
    "cache-manager": "7.2.9",
    "cheerio": "1.2.0",
    "decimal.js": "10.6.0",
    "nestjs-pino": "5.3.1",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "playwright": "1.64.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "tough-cookie": "6.0.2",
    "typeorm": "1.1.2",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.8",
    "@nestjs/schematics": "12.0.6",
    "@nestjs/testing": "12.1.2",
    "@testcontainers/postgresql": "12.2.0",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/supertest": "7.2.1",
    "@vitest/coverage-v8": "5.0.3",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "oxlint": "1.87.0",
    "pino-pretty": "13.2.0",
    "prettier": "3.9.10",
    "supertest": "7.3.1",
    "typescript": "6.0.2",
    "vitest": "5.0.3"
  }
}
