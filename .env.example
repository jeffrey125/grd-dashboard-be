# Copy to .env for local development. Process environment overrides this file.
NODE_ENV=development
LOG_LEVEL=debug
PORT=3000

# Required by both entry points. Connection/pooling/TLS are implemented in V1-004.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=grd_dashboard
DB_USER=grd_dashboard
# Supply locally; blank passwords intentionally fail startup validation.
DB_PASSWORD=
DB_SSL_MODE=disable
# Managed PostgreSQL: verify-full, with its downloaded CA mounted at this path.
# Omit CA file only for a server signed by Node's default trusted roots.
DB_SSL_CA_FILE=

# Required by the worker when UPS is enabled. API startup does not require these.
# CIE is the default; production must be selected explicitly. RPM comes from carriers.
UPS_ENVIRONMENT=cie
UPS_CLIENT_ID=
UPS_CLIENT_SECRET=
# EchoShip: fetch mode is selected through the Carrier API, never .env.
# Credentials are required only when EchoShip is enabled in the worker.
# Use https://echoship.com/login; the browser preserves this login-page path.
ECHOSHIP_URL=
ECHOSHIP_USERNAME=
ECHOSHIP_PASSWORD=
# Optional system Chromium path; otherwise install with pnpm exec playwright install chromium.
# ECHOSHIP_BROWSER_EXECUTABLE_PATH=/path/to/chromium
# FFE: request/browser mode comes from the Carrier API; credentials required when enabled.
# Use https://www.ffeinc.com/Customer/ShipmentTracking. Both modes search the one-year archive.
FFE_URL=
FFE_USERNAME=
FFE_PASSWORD=
# Optional system Chromium path, used only in browser mode.
# FFE_BROWSER_EXECUTABLE_PATH=/path/to/chromium

# Optional worker notification topic. Blank disables alerts. Failed sends are discarded.
# Dedicated Axios publisher; no redirects, automatic retries, or persisted delivery queue.
NTFY_URL=

# API and local auth CLI only; worker does not need auth settings.
# Generate a random secret of at least 32 characters and store it outside source control.
AUTH_SECRET=
AUTH_BASE_URL=http://localhost:3000
AUTH_TRUSTED_ORIGINS=http://localhost:5173
# Only use loopback when the API is behind a trusted local reverse proxy.
AUTH_TRUST_PROXY=false

# Amazon Shipping SP-API sandbox. The worker uses API mode only; returned rates are
# simulated test data and are never treated as live commercial prices.
AMAZON_SP_API_SANDBOX_CLIENT_ID=
AMAZON_SP_API_SANDBOX_CLIENT_SECRET=
AMAZON_SP_API_SANDBOX_REFRESH_TOKEN=

# myUnishippers quote and sender-default browser login.
MYUNISHIPPERS_EMAIL=
MYUNISHIPPERS_PASSWORD=
