# Copy to .env for local development. Process environment overrides this file.
NODE_ENV=development
LOG_LEVEL=debug
PORT=3000

# Required by both entry points. Connection/pooling/TLS are implemented in V1-004.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=grd_dashboard
DB_USER=grd_dashboard
# Supply locally; blank passwords intentionally fail startup validation.
DB_PASSWORD=

# Future worker Carrier configuration; not required or consumed by V1-003.
UPS_ENVIRONMENT=
UPS_CLIENT_ID=
UPS_CLIENT_SECRET=
ECHOSHIP_URL=
ECHOSHIP_USERNAME=
ECHOSHIP_PASSWORD=
FFE_URL=
FFE_USERNAME=
FFE_PASSWORD=
