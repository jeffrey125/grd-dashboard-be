# Local Compose only; copy to .env.docker (ignored).
# Generate with: openssl rand -hex 32
AUTH_SECRET=
GRD_API_PORT=3000
AUTH_BASE_URL=http://localhost:3000
AUTH_TRUSTED_ORIGINS=http://localhost:5173

# Optional worker profile: enabled seeded Carriers need real credentials.
# Do not start it until you intend real provider I/O, or disable Carriers first.
UPS_ENVIRONMENT=cie
UPS_CLIENT_ID=
UPS_CLIENT_SECRET=
ECHOSHIP_URL=https://echoship.com/login
ECHOSHIP_USERNAME=
ECHOSHIP_PASSWORD=
FFE_URL=https://www.ffeinc.com/Customer/ShipmentTracking
FFE_USERNAME=
FFE_PASSWORD=
NTFY_URL=
